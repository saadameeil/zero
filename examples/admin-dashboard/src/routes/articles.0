pub fun GET(req: Request) -> Response {
    return Response.html("<!DOCTYPE html>
<html lang=\"ar\" dir=\"rtl\">
<head>
  <meta charset=\"UTF-8\">
  <title>المقالات - لوحة الإدارة</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; }
    header { background: #1e293b; border-bottom: 1px solid #334155; padding: 1rem 2rem; display: flex; align-items: center; justify-content: space-between; }
    header h1 { font-size: 1.25rem; font-weight: 700; color: #38bdf8; }
    main { padding: 2rem; max-width: 1200px; margin: 0 auto; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .btn { background: #0ea5e9; color: white; padding: 0.5rem 1rem; border-radius: 0.5rem; text-decoration: none; font-size: 0.875rem; font-weight: 600; }
    .section { background: #1e293b; border: 1px solid #334155; border-radius: 0.75rem; padding: 1.5rem; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: right; padding: 0.75rem; font-size: 0.8rem; color: #64748b; border-bottom: 1px solid #334155; }
    td { padding: 0.75rem; font-size: 0.875rem; border-bottom: 1px solid #0f172a; }
    .status { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
    .status.published { background: #064e3b; color: #4ade80; }
    .status.draft { background: #1c1917; color: #a3a3a3; }
    .actions a { color: #38bdf8; text-decoration: none; margin-left: 0.75rem; font-size: 0.8rem; }
    nav a { color: #94a3b8; text-decoration: none; margin-right: 1.5rem; font-size: 0.9rem; }
    nav a.active { color: #38bdf8; }
    .badge { background: #0ea5e9; color: white; font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 9999px; }
  </style>
</head>
<body>
  <header>
    <h1>لوحة الإدارة <span class=\"badge\">Zero</span></h1>
    <nav>
      <a href=\"/\">الرئيسية</a>
      <a href=\"/articles\" class=\"active\">المقالات</a>
      <a href=\"/api/stats\">الإحصائيات</a>
    </nav>
  </header>
  <main>
    <div class=\"toolbar\">
      <h2 style=\"font-size:1.1rem;color:#cbd5e1\">جميع المقالات</h2>
      <a href=\"/articles/new\" class=\"btn\">+ مقال جديد</a>
    </div>
    <div class=\"section\">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>العنوان</th>
            <th>الكاتب</th>
            <th>التاريخ</th>
            <th>الحالة</th>
            <th>الإجراءات</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>1</td>
            <td>مقدمة إلى لغة Zero</td>
            <td>المدير</td>
            <td>2026-05-18</td>
            <td><span class=\"status published\">منشور</span></td>
            <td class=\"actions\"><a href=\"/articles/1/edit\">تعديل</a><a href=\"#\">حذف</a></td>
          </tr>
          <tr>
            <td>2</td>
            <td>بناء واجهات برمجية بـ Zero</td>
            <td>المدير</td>
            <td>2026-05-15</td>
            <td><span class=\"status published\">منشور</span></td>
            <td class=\"actions\"><a href=\"/articles/2/edit\">تعديل</a><a href=\"#\">حذف</a></td>
          </tr>
          <tr>
            <td>3</td>
            <td>نظام الأنواع في Zero</td>
            <td>المدير</td>
            <td>2026-05-10</td>
            <td><span class=\"status draft\">مسودة</span></td>
            <td class=\"actions\"><a href=\"/articles/3/edit\">تعديل</a><a href=\"#\">حذف</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>")
}
